#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
src="$root/.upstream/ezyplatform-cli/src"
if [[ ! -d "$src/ezyplatform_cli" ]]; then
    echo 'Run python3 scripts/sync-upstream.py first.' >&2
    exit 1
fi
export PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}"
# -P keeps the working directory off sys.path so an untrusted checkout cannot
# shadow the pinned CLI module.
exec python3 -P -m ezyplatform_cli "$@"
