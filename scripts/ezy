#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
src="$root/.upstream/ezyplatform-cli/src"
if [[ ! -d "$src/ezyplatform_cli" ]]; then
    echo 'Run python3 scripts/sync-upstream.py first.' >&2
    exit 1
fi
export PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}"
# Run the pinned package as a directory: sys.path[0] becomes the package itself
# instead of the working directory, so an untrusted checkout cannot shadow the
# CLI module. Works on Python 3.9+ (unlike -P, which needs 3.11).
exec python3 "$src/ezyplatform_cli" "$@"
