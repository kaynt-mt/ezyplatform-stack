#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
src="$root/.upstream/ezyplatform-cli/src"
if [[ ! -d "$src/ezyplatform_cli" ]]; then
    echo 'Run python3 scripts/sync-upstream.py first.' >&2
    exit 1
fi
# -I keeps the working directory and PYTHON* variables off sys.path so an
# untrusted checkout cannot shadow the pinned CLI module (Python 3.9+).
exec python3 -I -c 'import sys; sys.path.insert(0, sys.argv[1]); sys.argv = ["ezy", *sys.argv[2:]]; from ezyplatform_cli.cli import main; sys.exit(main())' "$src" "$@"
